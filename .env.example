# @worlds/client provider
# No external API keys required — uses file-backed LibSQL for local eval runs.

# Judge / answering model (required for full pipeline)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Also supported by the Google AI SDK:
# GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (first-class answering model, judge, and fact extractor)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: override judge model via CLI
# bun run src/index.ts run -p worlds -b locomo -l 5 -j gemini-2.5-flash -m gemini-2.5-flash-lite

# --- Worlds provider tuning ---
# Embeddings: local nomic-embed-text via Ollama (default when EMBEDDING_PROVIDER=ollama).
#   Ollama must be running (http://localhost:11434) with `nomic-embed-text` pulled.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL decouples embeddings from OPENAI_BASE_URL (defaults to Ollama's endpoint).
EMBEDDING_BASE_URL=

# Fact extraction: 'gemini' (default), 'ollama'/'openai' (local OpenAI-format), or 'deepseek'.
#   'deepseek' uses DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL; 'none' disables extraction.
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=

# Shared content-addressed cache lives under data/cache/ (embeddings + extraction).
# Reset it explicitly with: bun run src/index.ts cache-clear
